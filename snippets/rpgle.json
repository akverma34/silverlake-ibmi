{
  "Free-format program": {
    "prefix": [
      "**free",
      "program"
    ],
    "description": "Skeleton of a fully free-format RPG program",
    "body": [
      "**free",
      "ctl-opt dftactgrp(*no) actgrp(*caller) option(*srcstmt: *nodebugio);",
      "",
      "dcl-pi *n;",
      "  ${1:parm1} char(${2:10});",
      "end-pi;",
      "",
      "$0",
      "",
      "*inlr = *on;",
      "return;"
    ]
  },
  "ctl-opt": {
    "prefix": "ctl-opt",
    "body": [
      "ctl-opt dftactgrp(*no) actgrp(${1|*caller,*new,QILE|}) option(*srcstmt: *nodebugio)${2: bnddir('${3:MYBNDDIR}')};"
    ]
  },
  "dcl-s": {
    "prefix": "dcl-s",
    "body": [
      "dcl-s ${1:name} ${2|char,varchar,packed,zoned,int,uns,date,time,timestamp,ind,pointer|}(${3:10})${4: inz};"
    ]
  },
  "dcl-c": {
    "prefix": "dcl-c",
    "body": [
      "dcl-c ${1:NAME} ${2:'value'};"
    ]
  },
  "dcl-ds": {
    "prefix": "dcl-ds",
    "body": [
      "dcl-ds ${1:name} qualified${2: template};",
      "  ${3:field} ${4:char(10)};",
      "end-ds;"
    ]
  },
  "dcl-ds likeds": {
    "prefix": "dcl-ds-likeds",
    "body": [
      "dcl-ds ${1:name} likeds(${2:template})${3: inz(*likeds)};"
    ]
  },
  "dcl-ds extname": {
    "prefix": "dcl-ds-extname",
    "body": [
      "dcl-ds ${1:name} extname('${2:FILE}') qualified ${3|*input,*output,*all,*key|} end-ds;"
    ]
  },
  "dcl-f": {
    "prefix": "dcl-f",
    "body": [
      "dcl-f ${1:FILE} ${2|disk,workstn,printer|} usage(${3|*input,*update,*output,*update:*delete:*output|}) ${4:keyed};"
    ]
  },
  "dcl-proc": {
    "prefix": "dcl-proc",
    "description": "Subprocedure with interface",
    "body": [
      "dcl-proc ${1:name}${2: export};",
      "  dcl-pi *n ${3:ind};",
      "    ${4:parm} ${5:char(10)} const;",
      "  end-pi;",
      "",
      "  $0",
      "",
      "  return ${6:*on};",
      "end-proc;"
    ]
  },
  "dcl-pr extpgm": {
    "prefix": "dcl-pr-extpgm",
    "description": "Prototype for a program call",
    "body": [
      "dcl-pr ${1:name} extpgm('${2:PGMNAME}');",
      "  ${3:parm} char(${4:10});",
      "end-pr;"
    ]
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition};",
      "  $0",
      "endif;"
    ]
  },
  "if-else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition};",
      "  $2",
      "else;",
      "  $0",
      "endif;"
    ]
  },
  "dow": {
    "prefix": "dow",
    "body": [
      "dow ${1:condition};",
      "  $0",
      "enddo;"
    ]
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} = ${2:1} to ${3:%elem(array)};",
      "  $0",
      "endfor;"
    ]
  },
  "for-each": {
    "prefix": "for-each",
    "body": [
      "for-each ${1:item} in ${2:array};",
      "  $0",
      "endfor;"
    ]
  },
  "select": {
    "prefix": "select",
    "body": [
      "select;",
      "  when ${1:condition};",
      "    $2",
      "  other;",
      "    $0",
      "endsl;"
    ]
  },
  "monitor": {
    "prefix": "monitor",
    "body": [
      "monitor;",
      "  $1",
      "on-error;",
      "  $0",
      "endmon;"
    ]
  },
  "read loop": {
    "prefix": "readloop",
    "description": "SETLL + READE loop",
    "body": [
      "setll (${1:key}) ${2:FILE};",
      "reade (${1:key}) ${2:FILE};",
      "dow not %eof(${2:FILE});",
      "  $0",
      "  reade (${1:key}) ${2:FILE};",
      "enddo;"
    ]
  },
  "chain": {
    "prefix": "chain",
    "body": [
      "chain (${1:key}) ${2:FILE};",
      "if %found(${2:FILE});",
      "  $0",
      "endif;"
    ]
  },
  "exec sql select into": {
    "prefix": "sqlselect",
    "body": [
      "exec sql SELECT ${1:col} INTO :${2:var} FROM ${3:table} WHERE ${4:key} = :${5:value};",
      "if sqlcode <> 0;",
      "  $0",
      "endif;"
    ]
  },
  "exec sql cursor": {
    "prefix": "sqlcursor",
    "description": "Embedded SQL cursor loop",
    "body": [
      "exec sql DECLARE ${1:c1} CURSOR FOR",
      "  SELECT ${2:col} FROM ${3:table};",
      "exec sql OPEN ${1:c1};",
      "exec sql FETCH NEXT FROM ${1:c1} INTO :${4:var};",
      "dow sqlcode = 0;",
      "  $0",
      "  exec sql FETCH NEXT FROM ${1:c1} INTO :${4:var};",
      "enddo;",
      "exec sql CLOSE ${1:c1};"
    ]
  },
  "snd-msg": {
    "prefix": "snd-msg",
    "body": [
      "snd-msg ${1|*info,*escape,*diag,*notify,*comp|} ${2:'message'};"
    ]
  },
  "psds": {
    "prefix": "psds",
    "description": "Program status data structure",
    "body": [
      "dcl-ds psds psds qualified;",
      "  program *proc;",
      "  status *status;",
      "  msgId char(7) pos(40);",
      "  msgText char(80) pos(91);",
      "  job char(10) pos(244);",
      "  user char(10) pos(254);",
      "  jobNumber zoned(6) pos(264);",
      "  currentUser char(10) pos(358);",
      "end-ds;",
      "$0"
    ]
  },
  "infds": {
    "prefix": "infds",
    "description": "File information data structure",
    "body": [
      "dcl-ds ${1:file}Info qualified;",
      "  status *status;",
      "  opcode *opcode;",
      "  routine *routine;",
      "  rrn int(10) pos(397);",
      "end-ds;",
      "$0"
    ]
  },
  "nomain module": {
    "prefix": "nomain",
    "description": "Service program module skeleton",
    "body": [
      "**free",
      "ctl-opt nomain option(*srcstmt: *nodebugio);",
      "",
      "/copy ${1:QPROTOSRC},${2:MODULE}_P",
      "",
      "dcl-proc ${3:name} export;",
      "  dcl-pi *n ${4:int(10)};",
      "    ${5:parm} ${6:char(10)} const;",
      "  end-pi;",
      "",
      "  $0",
      "  return 0;",
      "end-proc;"
    ]
  },
  "dcl-proc monitor": {
    "prefix": "dcl-proc-monitor",
    "description": "Procedure with error handling",
    "body": [
      "dcl-proc ${1:name};",
      "  dcl-pi *n ind;",
      "    ${2:parm} ${3:char(10)} const;",
      "  end-pi;",
      "",
      "  monitor;",
      "    $0",
      "  on-error;",
      "    return *off;",
      "  endmon;",
      "  return *on;",
      "end-proc;"
    ]
  },
  "exec sql insert": {
    "prefix": "exec sql insert",
    "description": "Embedded SQL INSERT with SQLCODE test",
    "body": [
      "exec sql insert into ${1:table} (${2:col1}, ${3:col2})",
      "  values (:${4:host1}, :${5:host2});",
      "if sqlcode < 0;",
      "  $0",
      "endif;"
    ]
  },
  "exec sql update": {
    "prefix": "exec sql update",
    "description": "Embedded SQL UPDATE with SQLCODE test",
    "body": [
      "exec sql update ${1:table}",
      "  set ${2:col} = :${3:host}",
      "  where ${4:key} = :${5:keyHost};",
      "if sqlcode < 0 or sqlcode = 100;",
      "  $0",
      "endif;"
    ]
  },
  "qcmdexc": {
    "prefix": "qcmdexc",
    "description": "Run a CL command with QCMDEXC",
    "body": [
      "dcl-pr qcmdexc extpgm('QCMDEXC');",
      "  cmd char(3000) const options(*varsize);",
      "  len packed(15:5) const;",
      "end-pr;",
      "dcl-s cmd varchar(3000);",
      "",
      "cmd = '${1:DLTOVR FILE(*ALL)}';",
      "monitor;",
      "  qcmdexc(cmd: %len(cmd));",
      "on-error;",
      "  $0",
      "endmon;"
    ]
  },
  "data-into json": {
    "prefix": "data-into",
    "description": "DATA-INTO from JSON with YAJLINTO",
    "body": [
      "data-into ${1:ds} %data(${2:jsonText}: 'case=any allowmissing=yes allowextra=yes')",
      "  %parser('YAJLINTO');",
      "$0"
    ]
  },
  "date arithmetic": {
    "prefix": "date-math",
    "description": "Date arithmetic and difference",
    "body": [
      "dcl-s ${1:today} date inz(*sys);",
      "dcl-s ${2:due} date;",
      "dcl-s ${3:days} int(10);",
      "",
      "${2} = ${1} + %days(${4:30});",
      "${3} = %diff(${2}: ${1}: *days);",
      "$0"
    ]
  },
  "sql cursor loop": {
    "prefix": "for-each-sql",
    "description": "SQL cursor loop with close",
    "body": [
      "exec sql declare ${1:c1} cursor for",
      "  select ${2:col} from ${3:table};",
      "exec sql open ${1};",
      "dow 1 = 1;",
      "  exec sql fetch next from ${1} into :${4:host};",
      "  if sqlcode <> 0;",
      "    leave;",
      "  endif;",
      "  $0",
      "enddo;",
      "exec sql close ${1};"
    ]
  }
}
